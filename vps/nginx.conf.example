# nginx.conf.example — HTTPS reverse proxy that exposes the phone's adb_mcp server
# (reached through the SSH reverse tunnel on 127.0.0.1:18080) as a token-protected
# MCP endpoint at https://<YOUR_DOMAIN>/phone/ .
#
# Copy to /etc/nginx/sites-available/<YOUR_DOMAIN>, replace every <PLACEHOLDER>,
# symlink into sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# !! The real file holds your auth token. Keep it OUT of git (see .gitignore).
# Generate a token with e.g.:  python3 -c 'import secrets; print("sk-" + secrets.token_hex(16))'

server {
    listen 80;
    listen [::]:80;
    server_name <YOUR_DOMAIN>;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <YOUR_DOMAIN>;

    ssl_certificate     <PATH_TO_FULLCHAIN_PEM>;
    ssl_certificate_key <PATH_TO_PRIVKEY_PEM>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Screenshots come back as base64 JSON; keep the body limit comfortable.
    client_max_body_size 32m;

    # ---- the phone endpoint ----
    # Everything under /phone/ requires `Authorization: Bearer <YOUR_TOKEN>`.
    # Whoever holds this token has full control of the (unlocked) phone — treat it like a password.
    location /phone/ {
        if ($http_authorization != "Bearer <YOUR_TOKEN>") { return 401; }

        # 18080 is the VPS-side port of the SSH reverse tunnel (qi.sh: VPS_PORT).
        # The trailing slash strips the /phone prefix, so /phone/health -> /health on the phone.
        proxy_pass http://127.0.0.1:18080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        # rapid_tap / long screenshots can take a while; don't let nginx cut them off.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Anything else on this vhost: nothing to see.
    location / {
        return 404;
    }
}
